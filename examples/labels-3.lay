[layout]
version=1
name=Etiquetas - 3 colunas
pageWidthMm=104
pageHeightMm=60
labelWidthMm=32
labelHeightMm=24
columns=3
columnGapMm=2
rowGapMm=2
marginLeftMm=2
marginTopMm=2
marginRightMm=2
marginBottomMm=2

[format]
decimalSeparator=,
thousandSeparator=.

[field.titulo]
source=fixed
type=text
value=AMOSTRA
xMm=1
yMm=1
widthMm=auto
heightMm=3
fontSizePt=6
bold=true
align=center

[field.descricao]
source=variable
type=text
bind=descricao
mask={value}
xMm=1
yMm=5
widthMm=auto
heightMm=3
fontSizePt=5.5

[field.lote]
source=variable
type=text
bind=lote
mask=L:{value}
xMm=1
yMm=9
widthMm=auto
heightMm=3
fontSizePt=5.5

[field.validade]
source=variable
type=date
bind=validade
mask=dd/mm/yy
prefix=Dt:
xMm=1
yMm=13
widthMm=auto
heightMm=3
fontSizePt=5.5

[field.valor]
source=variable
type=decimal
bind=valor
mask=#,##0.00
prefix=R$
xMm=1
yMm=17
widthMm=auto
heightMm=3
fontSizePt=5.5

[field.sequencia]
source=variable
type=integer
bind=sequencia
mask=000
prefix=#
xMm=1
yMm=20
widthMm=auto
heightMm=3
fontSizePt=5.5
align=right
